<div class="as-bar">
  <% if params[:from] == 'station' %>
    <%= link_to({ controller: 'stations', action: 'shipments', id: params[:from_station_id] }, class: 'left') do %>
      <%= svg_tag 'angle-left', kind: 'regular' %>
    <% end %>
  <% else %>
    <%= link_to({ action: 'stations' }, class: 'left') do %>
      <%= svg_tag 'angle-left', kind: 'regular' %>
    <% end %>
  <% end %>
  <div class="bar-title">
    <%= svg_tag 'person-dolly' %>
    <span><%= t('.title') %></span>
  </div>
  <i class="right"></i>
</div>
