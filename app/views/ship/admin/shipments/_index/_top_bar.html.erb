<div class="as-bar">
  <%= link_to({ controller: 'lines' }, class: 'left') do %>
    <%= svg_tag 'angle-left', kind: 'regular' %>
  <% end %>
  <div class="bar-title">
    <i class="fa-solid fa-person-dolly text-success"></i>
    <span class="pl-1"><%= @line.name %></span>
    <span class="pl-1"><%= t('.title') %></span>
  </div>
  <i class="right"></i>
</div>
