<li><%= link_to t('.packages.index.title'), { controller: 'packages', anchor: "tr_#{@package.id}" } %></li>
<li><span class="px-3"><%= @package.id %></span></li>
<% if @package.address %>
<li>
  <span class="px-3">
    <span><%= @package.address.area.full_name %></span>
    <span><%= @package.address.detail %></span>
  </span>
</li>
<% end %>
<li class="is-active"><%= t('.title') %></li>
