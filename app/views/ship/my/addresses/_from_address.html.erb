<label class="media" for="address_id_<%= address.id %>">
  <div class="media-content">
    <p>
      <strong><%= address.contact_person %></strong>
      <span><%= address.tel %></span>
      <% if address.station %>
        <span class="tag"><%= address.station.name %></span>
      <% end %>
    </p>
    <p class="text-grey size-7">
      <span><%= address.area.full_name %></span>
      <span><%= address.detail %></span>
    </p>
  </div>
  <div class="media-right" data-controller="input">
    <%= hidden_field_tag 'button', 'new', id: nil, form: 'new_order' %>
    <%=
      radio_button_tag(
        'order[from_address_id]',
        address.id,
        address.id.to_s == params[:from_address_id],
        class: 'check',
        id: "address_id_#{address.id}",
        form: 'new_order',
        data: { action: 'input#form' }
      )
    %>
  </div>
</label>
