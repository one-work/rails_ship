<div id="box" class="card">
  <div class="card-header">
    <%= link_to '返回', { action: 'index' }, class: 'button is-borderless' %>
    <%= button_to({ action: 'destroy', id: model.id }, method: :delete, data: { turbo_confirm: t('.destroy.confirm') }, class: 'button is-danger') do %>
      <span>删除</span>
    <% end %>
  </div>
  <div class="card-content">
    <%= render partial: 'edit_form', locals: { model: model } %>
  </div>
</div>
