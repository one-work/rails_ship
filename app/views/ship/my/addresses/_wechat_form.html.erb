<%= form_with theme: 'phone_modal', model: @address, url: { action: 'wechat' }, data: { controller: 'wechat_address' } do |f| %>
  <header class="modal-card-head">
    <button class="button is-small">返回</button>
    <div class="modal-card-title">选择</div>
    <button class="delete" data-action="modal#hide"></button>
  </header>
  <section id="modal_card_body" class="modal-card-body">
    <%= f.text_field :contact_person %>
    <%= f.text_field :tel %>
    <div class="field">
      <div class="label text-grey"><%= Ship::Address.human_attribute_name(:area_id) %></div>
      <div class="field is-grouped">
        <%= text_field_tag :provinceName, params[:provinceName], class: 'input', readonly: true %>
        <%= text_field_tag :cityName, params[:cityName], class: 'input', readonly: true %>
        <%= text_field_tag :countyName, params[:countyName], class: 'input', readonly: true %>
      </div>
    </div>
    <%= f.text_area :detail %>
    <%= f.text_field :post_code %>
    <%= hidden_field_tag :return_to, params[:return_to] %>
  </section>
  <%= f.submit %>
<% end %>
