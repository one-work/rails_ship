<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary"><%= t('ship.admin.title') %></span>
  </div>
  <div class="card-content fixed-grid has-4-cols">
    <div class="grid">
      <%= link_to({ controller: 'ship/admin/items' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'list', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('ship.admin.items.index.title') %></div>
      <% end %>
    </div>
  </div>
</div>
